{
  "manifest_version": 3,
  "name": "JustSave",
  "version": "0.8",
  "description": "Capture the visible area or the entire page, then save it as PNG, JPG or PDF, copy it, or print it.",
  "minimum_chrome_version": "123",
  "permissions": ["activeTab", "scripting", "debugger"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "action": { "default_title": "JustSave: capture this page", "default_popup": "popup.html", "default_icon": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" } }
}
